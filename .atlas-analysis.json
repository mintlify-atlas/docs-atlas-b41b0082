  "keyFeatures": [
    "Easy integration into any Gorilla Tag BepInEx mod",
    "Real-time admin commands for player management",
    "Asset spawning and management system with 200+ preloaded assets",
    "Player teleportation, physics, and cosmetics control",
    "World and environment manipulation (weather, time, lighting)",
    "Lua scripting support via SafeLua",
    "Mod toggling and menu control",
    "Mute/unmute player management",
    "Controller input simulation",
    "Line renderer and platform spawning"
  ],
